# Local execution environment (copy to .env and fill values)

# Required for gh API calls
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Note: In Docker mode, GH_TOKEN must be set (container cannot use host gh keychain auth).

# Required for Claude decisions (review/approve/merge/follow-up)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub username
MY_GITHUB_USERNAME=your-github-username

# Allow-list of repositories this local runner can act on
TARGET_REPOS_JSON=["Zipstorm/spot-v2","Zipstorm/another-repo"]

# Active target repository for the current run (set per command/session)
TARGET_REPO=Zipstorm/spot-v2

# Local workspace paths
WORKSPACE=/absolute/path/to/git-automation
GITHUB_WORKSPACE=/absolute/path/to/git-automation

# Control-plane metadata (used by notify/follow-up exception logging)
GITHUB_REPOSITORY=your-org-or-user/your-control-repo

# Resolved policy/prompt paths for the active TARGET_REPO (set per run)
POLICY_FILE=config/repos/Zipstorm-spot-v2.yml
PROMPT_DIR=config/prompts/repos/Zipstorm/spot-v2

# Optional
# EXCEPTION_REGISTRY_ISSUE_NUMBER=123
