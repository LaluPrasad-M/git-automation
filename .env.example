# Local execution environment (copy to .env and fill values)

# Required for gh API calls
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Note: In Docker mode, GH_TOKEN must be set (container cannot use host gh keychain auth).

# Required for Claude decisions (review/approve/merge/follow-up)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub username
MY_GITHUB_USERNAME=your-github-username

# Auto-review PRs opened by these authors even if you're not added as reviewer (comma-separated)
# AUTO_REVIEW_AUTHORS=username1,username2

# Allow-list of repositories this listener can act on.
# Preferred format: JSON array.
# Also supported: comma-separated, e.g. Zipstorm/spot-v2,Zipstorm/another-repo
TARGET_REPOS_JSON=["Zipstorm/spot-v2"]

# Absolute path to this repo on your machine (used as workspace root)
WORKSPACE=/absolute/path/to/git-automation
# Note: GITHUB_WORKSPACE is auto-derived from WORKSPACE — no need to set it separately.

# Control-plane repo for audit logging and rate-limit checks (owner/repo format)
GITHUB_REPOSITORY=your-org-or-user/git-automation

# Optional
# EXCEPTION_REGISTRY_ISSUE_NUMBER=123   # issue number in GITHUB_REPOSITORY for exception-learning log (thread-followup)
# AUDIT_ISSUE_NUMBER=124                 # separate issue number for pipeline run audit log (notify)
