# Copy to .env and fill in values

# ── GitHub ───────────────────────────────────────────────────────────────────

# Fine-grained PAT with write access to target repos
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub login — reviewer identity and self-filter
MY_GITHUB_USERNAME=your-github-username


# ── Repositories ─────────────────────────────────────────────────────────────

# Comma-separated repos to watch
TARGET_REPOS=owner/repo1,owner/repo2

# Also review PRs opened by these authors without explicit reviewer assignment
# Global: username1,username2  |  Scoped: all:username1,org/repo:username2
# AUTO_REVIEW_AUTHORS=username1,username2

# ── LLM ──────────────────────────────────────────────────────────────────────

# Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6  # default; override to use a different model
# MAX_TURNS=5                        # max LLM tool-call turns per review (default: 5)

# Switch to OpenAI: set LLM_PROVIDER=openai and provide key
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o

# ── Listener ─────────────────────────────────────────────────────────────────

# DRY_RUN=true                        # suppress all write operations (testing)
# POLL_INTERVAL_SECONDS=60            # how often to poll GitHub Events API (default: 60s)

# ── Logging ──────────────────────────────────────────────────────────────────

# SENTINEL_LOG=/path/to/repo.log  # override log file path (default: .state/logs/<owner>__<repo>.log)

# ── GitHub Actions mode ──────────────────────────────────────────────────────

# When using the sentinel.yml workflow instead of Docker, set credentials as
# repo Secrets/Variables in GitHub Settings rather than in this file.
# Secrets:   MY_PAT, ANTHROPIC_API_KEY
# Variables: MY_GITHUB_USERNAME, TARGET_REPOS
